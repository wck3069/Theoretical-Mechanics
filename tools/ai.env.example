# 复制到 ~/.config/tm-ai.env（推荐，chmod 600）或 tools/ai.env（已 gitignore）
TM_AI_BASE=https://xplt.sdu.edu.cn:4000/v1
TM_AI_MODEL=SDU-AI/DeepSeek-V4-Flash
TM_AI_KEY=replace-with-your-key
TM_AI_EFFORT_FAST=minimal
TM_AI_EFFORT_DEEP=medium
TM_AI_TIMEOUT=120

# 公网/学生访问时启用 Basic Auth
TM_AUTH_USER=理论力学
TM_AUTH_USER_ALT=lilun
TM_AUTH_PASS=change-me
